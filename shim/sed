#!/bin/sh
# PATH shim: refuses `sed -n p file.py` with no line range; ranged sed passes.
real=/bin/sed
[ -x "$real" ] || real=/usr/bin/sed
[ "${OUTLINE_HOOK:-warn}" = "off" ] && exec "$real" "$@"
[ $# -eq 3 ] && [ "$1" = "-n" ] || exec "$real" "$@"
case "$2" in *[0-9]*) exec "$real" "$@" ;; esac   # a real range -> fine
f=$3
case "$f" in
  *.py|*.ts|*.tsx|*.js|*.jsx|*.mjs|*.go|*.rs|*.rb|*.java|*.c|*.h|*.cpp|*.sh) ;;
  *) exec "$real" "$@" ;;
esac
[ -f "$f" ] || exec "$real" "$@"
n=$(wc -l < "$f")
[ "$n" -le "${OUTLINE_HOOK_MAX:-200}" ] && exec "$real" "$@"
# Long source file, no range. Warn by default; block only if OUTLINE_HOOK=block.
printf '%s is %s lines - `outline %s` gives its definitions in ~%s. Read a range with sed -n "N,Mp".\n' \
  "$f" "$n" "$f" "$(( n / 10 ))" >&2
[ "${OUTLINE_HOOK:-warn}" = "block" ] && exit 1
exec "$real" "$@"
